        "faq": [
            {
                "id": "f-jkw01",
                "visible": true,
                "q": "Berapa lama proses pemasangan?",
                "a": "Setelah data lengkap dan lokasi terjangkau, teknisi akan datang sesuai jadwal pilihanmu. Umumnya pemasangan selesai dalam 1–3 hari kerja, dan proses di lokasi hanya sekitar 2 jam."
            },
            {
                "id": "f-kkw01",
                "visible": true,
                "q": "Apakah ada biaya instalasi?",
                "a": "Tidak ada. Pemasangan gratis untuk semua paket, termasuk penarikan kabel fiber hingga 150 meter dan pinjaman router WiFi selama berlangganan."
            },
            {
                "id": "f-lkw01",
                "visible": true,
                "q": "Bagaimana cara membayar tagihan?",
                "a": "Tagihan bisa dibayar melalui transfer virtual account bank, e-wallet (GoPay, OVO, DANA, ShopeePay), QRIS, maupun gerai minimarket. Tagihan terbit setiap tanggal 1 dan jatuh tempo tanggal 20."
            },
            {
                "id": "f-mkw01",
                "visible": true,
                "q": "Bagaimana cara upgrade paket?",
                "a": "Hubungi customer service melalui WhatsApp atau call center. Upgrade diproses tanpa kunjungan teknisi dan kecepatan baru aktif paling lambat 1x24 jam."
            },
            {
                "id": "f-nkw01",
                "visible": true,
                "q": "Apa yang harus dilakukan jika internet gangguan?",
                "a": "Coba restart router terlebih dahulu dan pastikan lampu indikator LOS tidak menyala merah. Jika masih bermasalah, laporkan ke layanan 24 jam kami. Teknisi akan dikirim bila gangguan tidak bisa diselesaikan dari jarak jauh."
            }
        ]
    }
